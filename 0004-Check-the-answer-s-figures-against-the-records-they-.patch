diff --git a/__tests__/grounding.test.js b/__tests__/grounding.test.js
new file mode 100644
index 0000000..0cbaeb3
--- /dev/null
+++ b/__tests__/grounding.test.js
@@ -0,0 +1,268 @@
+'use strict';
+// The grounding check, tested against the thing it exists to catch.
+//
+// The system prompt tells the model to stay inside the retrieved data. These
+// tests do not check that the prompt says so — they check that when a model
+// ignores it, the service notices. So the central case is a fabricated figure,
+// and the assertion is that it comes back flagged.
+
+const request = require('supertest');
+const { buildApp } = require('../src/app');
+const { load } = require('../src/config');
+const { verifyGrounding, collectSourceNumbers, extractClaims } = require('../src/platform/grounding/verify');
+
+const config = load({
+  NODE_ENV: 'test',
+  AI_API_KEY: 'test-key',
+  ERP_BACKEND_URL: 'https://erp.example.test',
+  SERVICE_AUTH_SECRET: 'x'.repeat(48),
+  ALLOWED_ORIGINS: 'https://app.example.test',
+});
+
+describe('reading figures out of retrieved data', () => {
+  test('finds numbers however deeply they are buried', () => {
+    const found = collectSourceNumbers({
+      client: { weight_kg: 78.4 },
+      sessions: [{ id: 12, notes: 'completed 3 sets' }],
+    });
+
+    expect(found.has(78.4)).toBe(true);
+    expect(found.has(12)).toBe(true);
+    expect(found.has(3)).toBe(true);
+  });
+
+  test('reads figures out of strings, not just numeric fields', () => {
+    // The ERP returns plenty of these: "78.4 kg", "2026-03-15", "₹12,500".
+    // A collector that only walked typeof === 'number' would treat every one
+    // of them as absent, and then flag the model for quoting them correctly.
+    const found = collectSourceNumbers({
+      weight: '78.4 kg',
+      expires: '2026-03-15',
+      balance: '₹12,500',
+    });
+
+    expect(found.has(78.4)).toBe(true);
+    expect(found.has(2026)).toBe(true);
+    expect(found.has(15)).toBe(true);
+    expect(found.has(12500)).toBe(true);   // comma stripped, not read as 12
+  });
+
+  test('object keys count as source, because the model can quote them', () => {
+    const found = collectSourceNumbers({ week_12: { attended: true } });
+    expect(found.has(12)).toBe(true);
+  });
+});
+
+describe('reading claims out of an answer', () => {
+  test('list numbering is not a claim about the client', () => {
+    // Without this, every numbered answer reports "1", "2", "3" as figures —
+    // and a report that cries wolf on every turn is one nobody reads.
+    const claims = extractClaims('1. Weight is 78.4 kg\n2. Attendance is good');
+    expect(claims.map((c) => c.value)).toEqual([78.4]);
+  });
+
+  test('a number inside a sentence is a claim even when the line is numbered', () => {
+    const claims = extractClaims('1. He has 12 sessions left');
+    expect(claims.map((c) => c.value)).toEqual([12]);
+  });
+
+  test('each claim carries enough context to find it in the answer', () => {
+    const [claim] = extractClaims('Current weight is 78.4 kg, down from January.');
+    expect(claim.context).toContain('78.4');
+    expect(claim.line).toBe(1);
+  });
+});
+
+describe('grading an answer against its sources', () => {
+  const sources = [{ weight_kg: 78.4, sessions_remaining: 12 }];
+
+  test('a figure that is in the data is in-source', () => {
+    const g = verifyGrounding({ answer: 'Weight is 78.4 kg.', sources });
+    expect(g.inSource).toBe(1);
+    expect(g.unverified).toBe(0);
+    expect(g.figures).toEqual([]);
+  });
+
+  test('a fabricated figure is flagged — this is the whole point', () => {
+    // The model was told to ground every claim. It invented a body-fat number
+    // that appears nowhere in the data. Nothing about the answer's wording
+    // gives that away; only the comparison does.
+    const g = verifyGrounding({ answer: 'Body fat is 22.7%.', sources });
+
+    expect(g.unverified).toBe(1);
+    // Reported as written, percent sign and all — the flag is read by a human
+    // looking for that figure in the answer, so it has to look like it does
+    // there. The stripped 22.7 is what the comparison used.
+    expect(g.figures[0].text).toBe('22.7%');
+    expect(g.figures[0].value).toBe(22.7);
+    expect(g.figures[0].status).toBe('unverified');
+  });
+
+  test('a difference the model computed is derived, not flagged as invented', () => {
+    // 78.4 and 82.0 are both in the data; 3.6 is neither, but it is the
+    // subtraction a trainer actually asked for. Flagging it would punish the
+    // model for answering the question.
+    const g = verifyGrounding({
+      answer: 'Down 3.6 kg since January.',
+      sources: [{ current: 78.4, january: 82.0 }],
+    });
+
+    expect(g.derived).toBe(1);
+    expect(g.unverified).toBe(0);
+  });
+
+  test('grading is per figure — one bad number in a good answer still surfaces', () => {
+    const g = verifyGrounding({
+      answer: 'Weight is 78.4 kg and body fat is 22.7%.',
+      sources,
+    });
+
+    expect(g.checked).toBe(2);
+    expect(g.inSource).toBe(1);
+    expect(g.unverified).toBe(1);
+    expect(g.figures[0].text).toBe('22.7%');
+  });
+
+  test('an answer with no figures is not a failure', () => {
+    // "I don't have a recent recorded weight for this client" is exactly what
+    // the prompt asks for when data is missing. It must not be graded as
+    // suspicious for containing nothing to check.
+    const g = verifyGrounding({ answer: 'I have no recorded weight for this client.', sources });
+    expect(g.checked).toBe(0);
+    expect(g.unverified).toBe(0);
+  });
+
+  test('with no sources at all, every figure is unverified', () => {
+    // The state after every tool failed. If the model answers anyway — from
+    // general fitness knowledge, which the prompt forbids — every number it
+    // writes is unsupported, and this is what says so.
+    const g = verifyGrounding({ answer: 'Weight is around 80 kg.', sources: [] });
+    expect(g.unverified).toBe(1);
+  });
+
+  test('formatting differences do not create false alarms', () => {
+    // 12500 in the data, "12,500" in the answer. Same figure; a naive string
+    // comparison would report the model for correctly formatting currency.
+    const g = verifyGrounding({
+      answer: 'Outstanding balance is 12,500.',
+      sources: [{ balance: 12500 }],
+    });
+    expect(g.unverified).toBe(0);
+  });
+});
+
+describe('the service reports grounding on the wire', () => {
+  const fakeErp = (data) => ({
+    get: async (path) => (path.endsWith('/snapshot')
+      ? { data, latency_ms: 1 }
+      : { data: { data: { name: 'Rahul Sharma' } }, latency_ms: 1 }),
+  });
+
+  const providerSaying = (content) => ({
+    name: 'fake',
+    generate: async ({ model }) => ({
+      content, model: model || 'fake-model', usage: { prompt: 10, completion: 5 }, latency_ms: 1,
+    }),
+  });
+
+  test('a grounded answer reports nothing to flag', async () => {
+    const app = buildApp({
+      config,
+      erp: fakeErp({ weight_kg: 78.4 }),
+      provider: providerSaying('FACT — weight is 78.4 kg.'),
+    });
+
+    const res = await request(app).post('/ai/client-agent/chat')
+      .set('Authorization', 'Bearer user-jwt')
+      .send({ clientId: 'c-1', message: 'Summarize this client' });
+
+    expect(res.status).toBe(200);
+    expect(res.body.grounding.unverified).toBe(0);
+    expect(res.body.grounding.checked).toBeGreaterThan(0);
+  });
+
+  test('a fabricated figure reaches the caller as a flag, not a silent success', async () => {
+    // The response is still a 200 with the answer in it — the service does not
+    // suppress or rewrite what the model said. It hands the trainer the answer
+    // AND the fact that one figure in it is unsupported, and lets them judge.
+    const app = buildApp({
+      config,
+      erp: fakeErp({ weight_kg: 78.4 }),
+      provider: providerSaying('FACT — body fat is 22.7%.'),
+    });
+
+    const res = await request(app).post('/ai/client-agent/chat')
+      .set('Authorization', 'Bearer user-jwt')
+      .send({ clientId: 'c-1', message: 'Summarize this client' });
+
+    expect(res.status).toBe(200);
+    expect(res.body.message).toContain('22.7');
+    expect(res.body.grounding.unverified).toBe(1);
+    expect(res.body.grounding.figures[0].text).toBe('22.7%');
+  });
+
+  test('the streaming route reports it too, on the done event', async () => {
+    const app = buildApp({
+      config,
+      erp: fakeErp({ weight_kg: 78.4 }),
+      provider: providerSaying('FACT — body fat is 22.7%.'),
+    });
+
+    const res = await request(app).post('/ai/client-agent/chat/stream')
+      .set('Authorization', 'Bearer user-jwt')
+      .buffer(true)
+      .send({ clientId: 'c-1', message: 'Summarize this client' });
+
+    const done = String(res.text).split('\n')
+      .filter((l) => l.startsWith('data: '))
+      .map((l) => JSON.parse(l.slice(6)))
+      .find((e) => e.type === 'done');
+
+    expect(done.grounding.unverified).toBe(1);
+  });
+
+  test('a figure the trainer supplied cannot launder itself into the answer', async () => {
+    // The realistic version of the prompt-vs-data mistake. A trainer asks a
+    // leading question carrying a wrong number — "his body fat is 22.7%,
+    // right?" — and the model agrees and repeats it. That figure IS in the
+    // prompt, because the question is in the prompt. It is not in the client's
+    // record, and the record is what the trainer will act on.
+    //
+    // So the check must compare against what the ERP returned, never against
+    // the conversation. Otherwise the one thing a trainer most needs flagged —
+    // the model confirming their own mistaken figure — is the one thing that
+    // always passes.
+    const app = buildApp({
+      config,
+      erp: fakeErp({ weight_kg: 78.4 }),
+      provider: providerSaying('Yes — body fat is 22.7%.'),
+    });
+
+    const res = await request(app).post('/ai/client-agent/chat')
+      .set('Authorization', 'Bearer user-jwt')
+      .send({ clientId: 'c-1', message: 'His body fat is 22.7%, right?' });
+
+    expect(res.body.grounding.figures.map((f) => f.text)).toContain('22.7%');
+  });
+
+  test('the check runs against retrieved data, not against the prompt text', async () => {
+    // The fenced context block contains the fence id, the preamble and the
+    // postamble — all of which carry digits. Verifying against the prompt
+    // instead of the ERP payload would let that boilerplate launder a
+    // fabricated figure into "in-source".
+    const app = buildApp({
+      config,
+      erp: fakeErp({ weight_kg: 78.4 }),
+      // The fence nonce is base64url of 9 random bytes, so it frequently
+      // contains digits; asserting on a figure that is definitely not in the
+      // ERP payload catches the mistake regardless of what the nonce holds.
+      provider: providerSaying('Body fat is 91.37%.'),
+    });
+
+    const res = await request(app).post('/ai/client-agent/chat')
+      .set('Authorization', 'Bearer user-jwt')
+      .send({ clientId: 'c-1', message: 'Summarize this client' });
+
+    expect(res.body.grounding.figures.map((f) => f.text)).toContain('91.37%');
+  });
+});
