diff --git a/src/platform/grounding/verify.js b/src/platform/grounding/verify.js
new file mode 100644
index 0000000..74eee14
--- /dev/null
+++ b/src/platform/grounding/verify.js
@@ -0,0 +1,181 @@
+'use strict';
+// Checking the answer against the data it was supposed to come from.
+//
+// The system prompt already tells the model to ground every claim in retrieved
+// data and to say "I don't have that" rather than fill a gap (prompt.js:19-24).
+// That is an instruction, and an instruction is a hope. This file is the part
+// that checks — after the model has written its answer, every figure in that
+// answer is looked for in the data the tools actually returned.
+//
+// ── What this can and cannot tell you ────────────────────────────────────────
+//
+// It verifies NUMBERS, not prose. "Rahul is progressing well" is unfalsifiable
+// here and always will be; "Rahul is 78.4 kg" is checkable, and it is the
+// figures a trainer acts on — a weight, a session count, an expiry date, an
+// outstanding balance. A fabricated adjective is a bad answer; a fabricated
+// number is a wrong decision about a real person.
+//
+// It is also deliberately one-directional. A figure found in the source is
+// evidence the model read the data. A figure NOT found is a flag for a human,
+// not a verdict — the model may have computed it legitimately (see DERIVED
+// below), or written it in a form this file does not recognise. So the output
+// is graded, never a pass/fail, and nothing here silently rewrites an answer.
+//
+// ── The known weakness, stated rather than hidden ────────────────────────────
+//
+// Small integers match by coincidence. "3" appears in almost any dataset, so a
+// hallucinated "3 sessions" will usually be marked in-source. That is a real
+// false negative and no threshold fixes it — raising one would start hiding
+// genuine findings instead. Distinctive figures (78.4, 12500, a date) are where
+// this earns its keep, and they are also the ones that do damage when wrong.
+
+/** Numbers this close are the same number. Guards float noise, not rounding. */
+const EPSILON = 1e-9;
+
+/** Ceiling on the pairwise derivation scan — see isDerivable(). */
+const DERIVATION_SCAN_LIMIT = 400;
+
+/**
+ * Every number appearing anywhere in a tool result, however deeply nested and
+ * whether it is stored as a number or inside a string ("78.4 kg", "2026-03-15").
+ */
+function collectSourceNumbers(value, out = new Set()) {
+  if (value == null) return out;
+
+  if (typeof value === 'number' && Number.isFinite(value)) {
+    out.add(value);
+    return out;
+  }
+
+  if (typeof value === 'string') {
+    // Strings carry figures the JSON type does not: "78.4 kg", "₹12,500",
+    // "2026-03-15". Pull every numeric run out of the text.
+    for (const m of value.matchAll(/\d[\d,]*(?:\.\d+)?/g)) {
+      const n = Number(m[0].replace(/,/g, ''));
+      if (Number.isFinite(n)) out.add(n);
+    }
+    return out;
+  }
+
+  if (Array.isArray(value)) {
+    for (const v of value) collectSourceNumbers(v, out);
+    return out;
+  }
+
+  if (typeof value === 'object') {
+    // Keys as well as values: a key like "week_12" carries a figure the model
+    // can legitimately quote.
+    for (const [k, v] of Object.entries(value)) {
+      collectSourceNumbers(k, out);
+      collectSourceNumbers(v, out);
+    }
+  }
+
+  return out;
+}
+
+/**
+ * Figures the model asserted, with enough surrounding text that a human reading
+ * the flag can find them in the answer.
+ */
+function extractClaims(answer) {
+  const claims = [];
+  const lines = String(answer || '').split('\n');
+
+  lines.forEach((line, lineNo) => {
+    // A leading "1." or "2)" is list furniture the model wrote, not a claim
+    // about the client. Counting it would flood the report with noise on every
+    // numbered answer.
+    const body = line.replace(/^\s*\d+[.)]\s+/, '');
+
+    for (const m of body.matchAll(/\d[\d,]*(?:\.\d+)?%?/g)) {
+      const raw = m[0];
+      const value = Number(raw.replace(/[,%]/g, ''));
+      if (!Number.isFinite(value)) continue;
+
+      claims.push({
+        text: raw,
+        value,
+        line: lineNo + 1,
+        // A short window around the figure, so "78.4" in the report reads as
+        // "current weight 78.4 kg, down from" rather than a bare number.
+        context: body.slice(Math.max(0, m.index - 40), m.index + raw.length + 40).trim(),
+      });
+    }
+  });
+
+  return claims;
+}
+
+const near = (a, b) => Math.abs(a - b) < EPSILON;
+
+/**
+ * Is this figure a simple arithmetic step from two figures in the source?
+ *
+ * The model is asked to report change ("down 1.2 kg since January"), and 1.2 is
+ * a difference that appears nowhere in the data. Marking that unverified would
+ * flag the model for doing exactly what a trainer wants. So a value reachable
+ * as a difference or a sum of two source figures is reported as DERIVED — true
+ * of the arithmetic, honest about the fact that it was not read directly.
+ *
+ * This does widen the net: a fabricated number that happens to equal some
+ * difference is graded derived rather than unverified. Sums and differences
+ * only, never products or ratios, precisely to keep that net as small as it can
+ * be while still covering the case that actually occurs.
+ */
+function isDerivable(value, sourceList) {
+  // Pairwise, so cost is quadratic in the number of distinct source figures. A
+  // client snapshot carries dozens; a long attendance history could carry
+  // thousands, and that squared is real time on a request a trainer is waiting
+  // on. Past the cap the check is skipped, which grades a derived figure as
+  // unverified — the safe direction to fail in.
+  const limit = Math.min(sourceList.length, DERIVATION_SCAN_LIMIT);
+  for (let i = 0; i < limit; i += 1) {
+    for (let j = i + 1; j < limit; j += 1) {
+      const a = sourceList[i];
+      const b = sourceList[j];
+      if (near(value, Math.abs(a - b)) || near(value, a + b)) return true;
+    }
+  }
+  return false;
+}
+
+/**
+ * Grade every figure in an answer against the data the tools returned.
+ *
+ * @param {object} o
+ * @param {string} o.answer   The model's completed text.
+ * @param {Array}  o.sources  The `data` of each successful tool result.
+ * @returns {{checked, inSource, derived, unverified, figures}}
+ */
+function verifyGrounding({ answer, sources = [] }) {
+  const sourceNumbers = new Set();
+  for (const s of sources) collectSourceNumbers(s, sourceNumbers);
+  const sourceList = [...sourceNumbers];
+
+  const figures = extractClaims(answer).map((claim) => {
+    let status;
+    if (sourceNumbers.has(claim.value) || sourceList.some((n) => near(n, claim.value))) {
+      status = 'in-source';
+    } else if (isDerivable(claim.value, sourceList)) {
+      status = 'derived';
+    } else {
+      status = 'unverified';
+    }
+    return { ...claim, status };
+  });
+
+  const unverified = figures.filter((f) => f.status === 'unverified');
+
+  return {
+    checked: figures.length,
+    inSource: figures.filter((f) => f.status === 'in-source').length,
+    derived: figures.filter((f) => f.status === 'derived').length,
+    unverified: unverified.length,
+    // Only the flagged ones travel to the caller. The full list is large, and
+    // the two states nobody needs to act on are the two that dominate it.
+    figures: unverified,
+  };
+}
+
+module.exports = { verifyGrounding, collectSourceNumbers, extractClaims, isDerivable };
