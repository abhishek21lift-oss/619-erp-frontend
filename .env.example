# 619 ERP Frontend — env template
# Copy to .env.local and fill in real values.
# NEVER commit .env.local (it's in .gitignore).

# Backend API URL (Render deployment or local)
NEXT_PUBLIC_API_URL=https://six19-erp-api.onrender.com

# Node environment (auto-set by Next.js in production)
# NODE_ENV=production

# JWT secret — must match the backend JWT_SECRET exactly.
# Required for server-side route protection in src/proxy.ts (full JWT verification).
# Without this, the middleware falls back to cookie-presence + expiry check only.
JWT_SECRET=<same-value-as-backend-JWT_SECRET>

# Google OAuth — enables the "Sign in with Google" button on the login page
# Get from Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# Set Authorised JavaScript origins: https://your-domain.com
# Set Authorised redirect URIs: https://your-domain.com (no callback path needed — we use popup flow)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=<your-google-oauth-client-id>.apps.googleusercontent.com

# NOTE: WebAuthn/passkey config (RP_ID, WEBAUTHN_ORIGIN, RP_NAME) lives
# entirely on the backend — see 619-erp-backend/.env.example. The frontend
# has no code path that reads a WEBAUTHN_* variable.

# Supabase image hostname for Next.js image optimizer (M-02)
# Find in Supabase Dashboard → Settings → API → Project URL (hostname only)
NEXT_PUBLIC_SUPABASE_HOST=<your-project-ref>.supabase.co

# Full Supabase project URL — used by src/proxy.ts to build the CSP's
# connect-src allowlist. Same project as NEXT_PUBLIC_SUPABASE_HOST above,
# just the full URL instead of the bare hostname; both are required.
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co

# ── Sentry (client-side error monitoring, optional) ──────────────────
# Inert unless set.
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Branding (white-label — set per client deployment) ───────────────
# Shown as the support contact across the app. If unset, falls back to
# the original vendor's number — always set this for a new client.
NEXT_PUBLIC_SUPPORT_PHONE=+91XXXXXXXXXX

# ── CSP violation reporting (optional) ────────────────────────────────
# The strict, nonce-based Content-Security-Policy ships as Report-Only
# alongside the enforced one (see src/lib/security-headers.js). It breaks
# nothing; it only reports what WOULD be blocked if 'unsafe-inline' were
# removed from script-src. Leave unset and violations appear only in the
# browser console. Set it to collect them centrally before flipping the
# policy to enforced. Sentry accepts CSP reports at:
#   https://<org>.ingest.sentry.io/api/<project-id>/security/?sentry_key=<public-key>
# CSP_REPORT_URI=
