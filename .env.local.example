# 619 Fitness ERP — Frontend Environment Variables
# ─────────────────────────────────────────────────────────────────────
# Copy this file to .env.local for local development.
# NEVER commit .env.local — it is in .gitignore.
#
# Vercel deployment: set these in the Vercel project dashboard
#   Project Settings → Environment Variables
#
# Docker deployment: pass as --build-arg NEXT_PUBLIC_API_URL=https://...
#   or as -e NEXT_PUBLIC_API_URL=https://... at runtime.

# ── Backend API URL ───────────────────────────────────────────────────
# Local development (default if unset):
NEXT_PUBLIC_API_URL=http://localhost:5000
#
# Production examples:
# NEXT_PUBLIC_API_URL=https://api.619fitness.com
# NEXT_PUBLIC_API_URL=https://619-api.railway.app
# NEXT_PUBLIC_API_URL=https://619-api.onrender.com

# ── Optional: Analytics / Monitoring ─────────────────────────────────
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
